{
  "manifest_version": 3,
  "name": "Visor Media",
  "version": "1.0.0",
  "description": "Lets Visor show and control the music or video playing in this browser, from the MacBook notch.",
  "key": "",
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.soundcloud.com/*",
        "*://open.spotify.com/*",
        "*://music.apple.com/*",
        "*://*.twitch.tv/*",
        "*://*.vimeo.com/*",
        "*://*.bandcamp.com/*",
        "*://*.deezer.com/*",
        "*://*.tidal.com/*",
        "*://*.mixcloud.com/*",
        "*://music.amazon.com/*",
        "*://music.amazon.co.uk/*",
        "*://music.amazon.de/*",
        "*://music.amazon.co.jp/*",
        "*://music.amazon.fr/*",
        "*://*.pandora.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "media@visor.app",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
